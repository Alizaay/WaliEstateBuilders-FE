# Backend API base URL
# Development: http://localhost:5000/api  (or /api if using the Vite proxy)
VITE_API_URL=http://localhost:5000/api

# Production site URL for canonical links and Open Graph
VITE_SITE_URL=https://www.your-production-domain.com

# Company contact (already configured in code; override only if needed)
VITE_WHATSAPP_NUMBER=923040474640
VITE_PHONE_DISPLAY=03040474640
VITE_PHONE_TEL=03040474640

# Optional: set a real company email to show the email field/display
# Leave empty to hide email until configured
VITE_COMPANY_EMAIL=

# Optional: set a verified office address to show address block
VITE_OFFICE_ADDRESS=

# Optional: set a verified Google Maps embed URL to show map
VITE_MAP_EMBED_URL=

# Optional social profiles (leave empty to hide)
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=
